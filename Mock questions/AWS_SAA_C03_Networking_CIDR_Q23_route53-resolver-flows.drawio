<mxfile host="app.diagrams.net">
  <diagram id="inbound" name="Inbound (On-prem to AWS)">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="Route 53 Resolver INBOUND endpoint: on-premises resolves AWS private names" style="text;html=1;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="20" y="0" width="900" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="onprem" value="On-premises&lt;br&gt;192.168.0.0/16" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;dashed=1;verticalAlign=top;fontStyle=1;strokeColor=#5A6C86;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="20" y="50" width="260" height="380" as="geometry"/>
        </mxCell>
        <mxCell id="server" value="On-prem server" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1">
          <mxGeometry x="50" y="110" width="200" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="dns" value="On-prem DNS server&lt;br&gt;&lt;i&gt;Conditional forwarder:&lt;br&gt;corp.example.internal →&lt;br&gt;10.0.1.10, 10.0.2.10&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1">
          <mxGeometry x="50" y="270" width="200" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="vpn" value="VPN /&lt;br&gt;Direct Connect" style="ellipse;shape=cloud;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="330" y="215" width="140" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="vpc" value="VPC 10.0.0.0/16 (ap-southeast-1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FAEE;dashed=1;verticalAlign=top;fontStyle=1;strokeColor=#248814;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="520" y="50" width="600" height="380" as="geometry"/>
        </mxCell>
        <mxCell id="subA" value="Subnet 10.0.1.0/24 (AZ a)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5E0;verticalAlign=top;strokeColor=#248814;" vertex="1" parent="1">
          <mxGeometry x="550" y="100" width="240" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="eniA" value="Inbound endpoint ENI&lt;br&gt;&lt;b&gt;10.0.1.10&lt;/b&gt;&lt;br&gt;SG: allow UDP/TCP 53 from on-prem" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="570" y="140" width="200" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="subB" value="Subnet 10.0.2.0/24 (AZ b)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5E0;verticalAlign=top;strokeColor=#248814;" vertex="1" parent="1">
          <mxGeometry x="550" y="250" width="240" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="eniB" value="Inbound endpoint ENI&lt;br&gt;&lt;b&gt;10.0.2.10&lt;/b&gt;&lt;br&gt;SG: allow UDP/TCP 53 from on-prem" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="570" y="290" width="200" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="resolver" value="Route 53 Resolver&lt;br&gt;(VPC resolver)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="880" y="130" width="200" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="phz" value="Private hosted zone&lt;br&gt;&lt;b&gt;corp.example.internal&lt;/b&gt;&lt;br&gt;(associated with this VPC)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1">
          <mxGeometry x="880" y="270" width="200" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="e1" value="① App queries&lt;br&gt;app.corp.example.internal" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="server" target="dns">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" value="② Forward" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="dns" target="vpn">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3a" value="③ Private link" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="vpn" target="eniA">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3b" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;dashed=1;" edge="1" parent="1" source="vpn" target="eniB">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4a" value="④" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="eniA" target="resolver">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4b" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;dashed=1;" edge="1" parent="1" source="eniB" target="resolver">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e5" value="⑤ Lookup" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="resolver" target="phz">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="legend" value="⑥ The answer (e.g. 10.0.5.25) returns along the same path in reverse.&lt;br&gt;Solid and dashed arrows to the ENIs show the two AZs: the on-prem DNS can use either IP for resilience." style="text;html=1;align=left;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="20" y="450" width="900" height="40" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="outbound" name="Outbound (AWS to On-prem)">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="Route 53 Resolver OUTBOUND endpoint: VPC resolves on-premises names" style="text;html=1;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="20" y="0" width="900" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="vpc" value="VPC 10.0.0.0/16 (ap-southeast-1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FAEE;dashed=1;verticalAlign=top;fontStyle=1;strokeColor=#248814;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="20" y="50" width="640" height="420" as="geometry"/>
        </mxCell>
        <mxCell id="ec2" value="EC2 instance&lt;br&gt;(app server)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1">
          <mxGeometry x="50" y="100" width="160" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="resolver" value="Route 53 Resolver (VPC .2)&lt;br&gt;&lt;i&gt;Rule: FORWARD&lt;br&gt;onprem.example.internal&lt;br&gt;associated with this VPC&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="50" y="240" width="200" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="subA" value="Subnet 10.0.1.0/24 (AZ a)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5E0;verticalAlign=top;strokeColor=#248814;" vertex="1" parent="1">
          <mxGeometry x="380" y="100" width="250" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="eniA" value="Outbound endpoint ENI&lt;br&gt;&lt;b&gt;10.0.1.20&lt;/b&gt;&lt;br&gt;SG: allow UDP/TCP 53 out" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="400" y="140" width="210" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="subB" value="Subnet 10.0.2.0/24 (AZ b)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5E0;verticalAlign=top;strokeColor=#248814;" vertex="1" parent="1">
          <mxGeometry x="380" y="270" width="250" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="eniB" value="Outbound endpoint ENI&lt;br&gt;&lt;b&gt;10.0.2.20&lt;/b&gt;&lt;br&gt;SG: allow UDP/TCP 53 out" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="400" y="310" width="210" height="65" as="geometry"/>
        </mxCell>

        <mxCell id="vpn" value="VPN /&lt;br&gt;Direct Connect" style="ellipse;shape=cloud;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="710" y="205" width="140" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="onprem" value="On-premises&lt;br&gt;192.168.0.0/16" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;dashed=1;verticalAlign=top;fontStyle=1;strokeColor=#5A6C86;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="900" y="50" width="250" height="420" as="geometry"/>
        </mxCell>
        <mxCell id="dns1" value="On-prem DNS&lt;br&gt;&lt;b&gt;192.168.1.10&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1">
          <mxGeometry x="930" y="140" width="190" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="dns2" value="On-prem DNS&lt;br&gt;&lt;b&gt;192.168.1.11&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1">
          <mxGeometry x="930" y="300" width="190" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="e1" value="① Query&lt;br&gt;db.onprem.example.internal" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="ec2" target="resolver">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2a" value="② Rule matches" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="resolver" target="eniA">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2b" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;dashed=1;" edge="1" parent="1" source="resolver" target="eniB">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3a" value="③ Source IP&lt;br&gt;10.0.1.20" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="eniA" target="vpn">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3b" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;dashed=1;" edge="1" parent="1" source="eniB" target="vpn">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4a" value="④ Forward to target IPs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="vpn" target="dns1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4b" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;dashed=1;" edge="1" parent="1" source="vpn" target="dns2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="legend" value="⑤ The answer (e.g. 192.168.5.50) returns along the same path in reverse.&lt;br&gt;On-prem firewall must allow DNS from the endpoint IPs (10.0.1.20 / 10.0.2.20). Dashed arrows show the second AZ / second DNS target." style="text;html=1;align=left;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="20" y="490" width="1100" height="40" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
